;==========================================================
;
;
;   ██████╗  ██████╗ ██╗  ██╗   ██╗██████╗  █████╗ ██████╗
;   ██╔══██╗██╔═══██╗██║  ╚██╗ ██╔╝██╔══██╗██╔══██╗██╔══██╗
;   ██████╔╝██║   ██║██║   ╚████╔╝ ██████╔╝███████║██████╔╝
;   ██╔═══╝ ██║   ██║██║    ╚██╔╝  ██╔══██╗██╔══██║██╔══██╗
;   ██║     ╚██████╔╝███████╗██║   ██████╔╝██║  ██║██║  ██║
;   ╚═╝      ╚═════╝ ╚══════╝╚═╝   ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
;
;
;   To learn more about how to configure Polybar
;   go to https://github.com/polybar/polybar
;
;   The README contains a lot of information
;
;==========================================================

include-file = modules.ini

[colors]
background = #282A2E
background-alt = #373B41
foreground = #C5C8C6
primary = #F0C674
secondary = #8ABEB7
alert = #A54242
disabled = #707880
black = #4f506e

[bar/bar1]
width = 50%
height = 30pt

offset-x = 0.5%
offset-y = 1%

radius = 10.0
scroll-up = bspc desktop -f prev.occupied.local
scroll-down = bspc desktop -f next.occupied.local
; dpi = 96

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 1pt

border-size = 5pt
border-color = #00ffff

padding-left = 5pt
padding-right = 0

module-margin = 100

fixed-center = true

modules-left = bspwm
modules-center = xwindow
modules-right =

separator =
separator-foreground = ${colors.disabled}

font-0 = "JetBrainsMono Nerd Font:style=Regular;3"


cursor-click = pointer
cursor-scroll =

enable-ipc = true
wm-restack = bspwm

; wm-restack = generic
; wm-restack = i3

; override-redirect = true

[bar/bar2]

width = 39.5%
height = 30pt

radius = 10.0
offset-x = 60%
offset-y = 1%

modules-left =
modules-right = filesystem pulseaudio xkeyboard memory cpu date systray

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 1pt

border-size = 5pt
border-color = #00ffff

padding-left = 0
padding-right = 0

module-margin = 1

separator =
separator-foreground = ${colors.disabled}

font-0 = "JetBrainsMono Nerd Font:style=Regular;3"

cursor-click = pointer
cursor-scroll =

enable-ipc = true
wm-restack = bspwm
[settings]
screenchange-reload = true
pseudo-transparency = true

; vim:ft=dosini
